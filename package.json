{
  "name": "kus-io",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "КУСЬ.io (Kus.io): an agar.io-like browser game where soft candies bite pieces off each other",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "og": "node tools/build.mjs && node tools/og.mjs",
    "shots": "node tools/build.mjs && node tools/shots.mjs",
    "fonts": "node tools/fonts.mjs && node tools/build.mjs",
    "sfx":"node tools/sfx.mjs && node tools/build.mjs",
    "test": "node tools/build.mjs && node tests/run.mjs",
    "format": "prettier --write src/js tools tests"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
